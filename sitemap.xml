---
# Generated by Jekyll on every build (was hand-maintained until global-platform Phase 6).
# Lists every HTML page except: redirect stubs (redirect_to), pages with `sitemap: false`,
# noindex pages (robots front matter), the 404 page and the Search Console verification file.
# <loc> uses the same expression as the canonical tag in _layouts/default.html
# (page.url | absolute_url), so sitemap and canonical URLs can never disagree
# (e.g. the homepage is https://emargdarshan.com/, not /index.html).
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.html_pages %}
{%- if p.sitemap == false or p.redirect_to or p.url == "/404.html" %}{% continue %}{% endif %}
{%- if p.robots and p.robots contains "noindex" %}{% continue %}{% endif %}
{%- assign p_name = p.url | split: "/" | last %}
{%- if p_name and p_name contains "google" and p_name contains ".html" %}{% continue %}{% endif %}
<url><loc>{{ p.url | absolute_url }}</loc></url>
{%- endfor %}
</urlset>
